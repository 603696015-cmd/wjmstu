				admin/examroomPeice/peice_examroomAudit.jsp
			</result>
		</action>
		<!-- 总搜索--> 
		<action name="examRoomShoppping" class="com.sopia.examroompeice.action.ExamRoomPeiceAction" method="examRoomShoppping">
