				admin/examroomPeice/peice_examroomlist.jsp
			</result>
		</action>
		<!-- 价格审核 -->
		<action name="peice_audit_examroom" class="com.sopia.examroompeice.action.ExamRoomPeiceAction" method="peice_audit_examroom">
