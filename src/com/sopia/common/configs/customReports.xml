		</action>
		<action name="formula_insert_biaojian"
			class="com.sopia.schedule.action.CustomReportsAjaxAction" 
			method="formula_insert_biaojian">
		</action>
		
		<action name="list_modulemanage"
			class="com.sopia.schedule.action.CustomReportsAjaxAction" 
			method="list_modulemanage">
		</action>
		<action name="list_field_by_tablename"
			class="com.sopia.schedule.action.CustomReportsAjaxAction" 
			method="list_field_by_tablename">
		</action>
		<action name="checkJSZNameIsExist"
			class="com.sopia.schedule.action.CustomReportsAjaxAction" 
			method="checkJSZNameIsExist">
		</action>
		<action name="changeJSZId"
			class="com.sopia.schedule.action.CustomReportsAjaxAction" 
			method="changeJSZId">
		</action>
		<action name="deleteJSZById"
			class="com.sopia.schedule.action.CustomReportsAjaxAction" 
