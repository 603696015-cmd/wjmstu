<struts>
	<package name="customReports" extends="elearning">
		<action name="addCustomReportInit"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="addCustomReportInit">
			<result name="addCustomReportInitSuccess">
				admin/customReports/addCustomReportInit.jsp
			</result>
		</action>
		<action name="addCustomReport"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="addCustomReport">
			<result name="addCustomReport_success" >
				admin/customReports/addCustomReportsetInit1.jsp
			</result>
		</action>
		
		<action name="customReportList"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="customReportList">
			<result name="customReportList">
				admin/customReports/customReportList.jsp
			</result>
		</action>
		
		<action name="queryCustomReportById"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="queryCustomReportById">
			<result name="queryCustomReportById_success" >
				admin/customReports/addCustomReportsetInit1.jsp
			</result>
		</action>
		
		<action name="updateCustomReportBytree"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="updateCustomReportBytree">
			<result name="updateCustomReportBytree_success" >
				admin/customReports/addCustomReportsetInit2.jsp
			</result>
		</action>
		<action name="updateCustomReportById"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="updateCustomReportById">
			<result name="updateCustomReportById_success" >
				admin/customReports/addCustomReportsetInit3.jsp
			</result>
		</action>
		<action name="updateCustomReportFinal"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="updateCustomReportFinal">
			<result name="updateCustomReportFinal_success" >
				admin/customReports/addCustomReportsetInit4.jsp
			</result>
		</action>
		<action name="setover"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="setover">
			<result name="setover_success" type="redirectAction">
				customReportList.action
			</result>
		</action>
		
		
		<action name="customReportZDYInit"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="customReportZDYInit">
			<result name="customReportZDYInit_success">
				<!-- admin/customReports/demo/${resultPage} -->
				admin/customReports/customReportZDYInit.jsp
			</result>
		</action>
		<action name="uploadJspInit"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="uploadJspInit">
			<result name="uploadJspInit_success">
				admin/customReports/uploadJspInit.jsp
			</result>
		</action>
		<action name="uploadJsp"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="uploadJsp">
			<result name="uploadJsp_success" type="redirectAction">
				customReportList.action
			</result>
			<result name="uploadJspInit" type="redirectAction">
				uploadJspInit.action?customReport.id={customReport.id}
			</result>
			
		</action>
		<action name="getJSZByLableid"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="getJSZByLableid">
			<result name="getJSZByLableid_success">
				admin/customReports/getJSZByLableidInit.jsp
			</result>
		</action>
		
		
		
		<action name="deleteLableById"
				 class="com.sopia.schedule.action.CustomReportsAction"
				 method="deleteLableById">
			<result name="deleteLableById_success" type="redirectAction">
				customReportList.action?elmessage=${elmessage}
			</result>
		</action>
		
		
