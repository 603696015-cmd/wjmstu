<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC 
"-//Apache Software Foundation//DTD Struts Configuation 2.0 //EN"
"struts-2.0.dtd">
<struts>
	<package name="security" extends="elearning">
		<action name="securitysetInit"
			class="com.sopia.security.action.SecurityAction"
			method="securitysetInit">
			<result name="securitysetInit">
				admin/security/securityset.jsp
			</result>
		</action>
		
		<action name="securityset"
			class="com.sopia.security.action.SecurityAction"
			method="securityset">
			<result name="securityset_success" type="redirectAction">
				securitysetInit.action
			</result>
		</action>
		
	</package>
</struts>