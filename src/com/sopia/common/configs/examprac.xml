			class="com.sopia.courseman.action.ExampracAction"
			method="examprac_simple_list">
			<result name="examprac_simple_list">
				admin/exam/examprac/examprac_simple_list.jsp
			</result>
		</action>
		<action name="examprac_quiz_Overview" 
			class="com.sopia.courseman.action.ExampracAction"
			method="examprac_quiz_Overview">
			<result name="examprac_quiz_Overview">
				admin/exam/examprac/examprac_quiz_Overview.jsp
			</result>
		</action>
		<action name="examprac_quiz_Detail" 
			class="com.sopia.courseman.action.ExampracAction"
			method="examprac_quiz_Detail">
			<result name="examprac_quiz_Detail">
				admin/exam/examprac/examprac_quiz_Detail.jsp
			</result>
		</action>
	</package>
</struts>