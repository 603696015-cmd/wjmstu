<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC 
"-//Apache Software Foundation//DTD Struts Configuation 2.0 //EN"
"struts-2.0.dtd">
<struts>  
	<package name="mode_xml" extends="elearning">
		<!-- 添加列表标签页面 -->
			<action name="mode_allmodeList" class="com.sopia.lable.action.ModeBindAction"  method="mode_allmodeList">
				<result name="success" >
					admin/mode/mode_allmodeList.jsp
				</result>
			</action>
			<action name="mode_modeviwe" class="com.sopia.lable.action.ModeBindAction"  method="mode_modeviwe">
				<result name="success" >
					admin/mode/mode_modeviwe.jsp
				</result>
			</action>
			<action name="mode_modepageList" class="com.sopia.lable.action.ModeBindAction"  method="mode_modepageList">
			</action>
			<action name="mode_updmodebind" class="com.sopia.lable.action.ModeBindAction"  method="mode_updmodebind">
				<result name="success" >
					admin/mode/mode_modeviwe.jsp
				</result>
				<result name="mode_typemodeviwe_success" >
					admin/mode/mode_modeytpebindviwe.jsp
				</result>
			</action>
			<action name="mode_removebind" class="com.sopia.lable.action.ModeBindAction"  method="mode_removebind">
				<result name="success" >
					admin/mode/mode_modeviwe.jsp
				</result>
				<result name="mode_typemodeviwe_success" >
					admin/mode/mode_modeytpebindviwe.jsp
				</result>
			</action>
			<action name="mode_typemodeviwe" class="com.sopia.lable.action.ModeBindAction"  method="mode_typemodeviwe">
				<result name="mode_typemodeviwe_success" >
					admin/mode/mode_modeytpebindviwe.jsp
				</result>
			</action>
			<action name="mode_updtypeextend" class="com.sopia.lable.action.ModeBindAction"  method="mode_updtypeextend">
				<result name="mode_typemodeviwe_success" >
					admin/mode/mode_modeytpebindviwe.jsp
				</result>
			</action>
			<action name="mode_action" class="com.sopia.lable.action.ModeBindAction"  method="mode_action">
				<result name="mode_action_success" >
					mode/${page}
				</result>
			</action>
			<action name="mode_updateDemoInit" class="com.sopia.lable.action.ModeBindAction"  method="mode_updateDemoInit">
				<result name="success" >
					admin/mode/mode_modeupload.jsp
				</result>
			</action>
			<action name="mode_updateDemo" class="com.sopia.lable.action.ModeBindAction"  method="mode_updateDemo">
				<result name="mode_updateDemo" >
					admin/mode/mode_modeupload.jsp
				</result>
			</action>
			<action name="mode_downloadDemoInit" class="com.sopia.lable.action.ModeBindAction"  method="mode_downloadDemoInit">
				<result name="success" >
					admin/mode/mode_downlist.jsp
				</result>
			</action>
			<action name="down" class="com.sopia.lable.action.ModeBindAction"  method="down">
			            <!-- 下载文件配置 -->
			           <!--type 为 stream 应用 StreamResult 处理--> 
			            <result name="down" type="stream"> 
			            <!--  不管实际类型，待下载文件 ContentType 统一指定为 application/octet-stream                        
			              默认为 text/plain                 -->   
			           <param name="contentType">application/octet-stream</param> 
			           <!--                          默认就是 inputStream，它将会指示 StreamResult 通过 inputName 属性值的 getter 方法，    
			                                              比如这里就是 getInputStream() 来获取下载文件的内容，意味着你的 Action 要有这个方法                  -->   
			           <param name="inputName">inputStream</param>
						<!--  默认为 inline(在线打开)，设置为 attachment 将会告诉浏览器下载该文件，filename 指定下载文
						 件保有存时的文件名，若未指定将会是以浏览的页面名作为文件名，如以 download.action 作为文件名，
						  这里使用的是动态文件名，${fileName}, 它将通过 Action 的 getFileName() 获得文件名                  -->  
						   <param name="contentDisposition">attachment;filename="${fileName}"</param>
						    <!-- 输出时缓冲区的大小 -->                 
						    <param name="bufferSize">4096</param>
						 </result>
			</action>
			
			<action name="mode_treeviwe" class="com.sopia.lable.action.ModeBindAction"  method="mode_treeviwe">
			</action>
			
    </package> 
</struts>