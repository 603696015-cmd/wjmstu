<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.2//EN"
                        "http://java.sun.com/dtd/web-jsptaglibrary_1_2.dtd">
<taglib>
	<tlib-version>1.0</tlib-version>
	<jsp-version>1.2</jsp-version>
	<short-name>userdemoLib</short-name>
	
	<tag>
		<name>listcolumns</name>
		<tag-class>com.sopia.userDemo.tags.listUserDemoColumns</tag-class>
	</tag>
	
	<tag>
		<name>userdemohtml</name>
		<tag-class>com.sopia.userDemo.tags.UserDemoHTML</tag-class>
		<attribute>
			<name>columnname</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<type>String</type>
		</attribute>
		<attribute>
			<name>pageid</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<type>int</type>
		</attribute>
		<attribute>
			<name>css</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<type>String</type>
		</attribute>
	</tag>
</taglib>
