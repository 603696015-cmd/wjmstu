<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.2//EN"
                        "http://java.sun.com/dtd/web-jsptaglibrary_1_2.dtd">
<taglib>
	<tlib-version>1.0</tlib-version>
	<jsp-version>1.2</jsp-version>
	<short-name>newversionLib</short-name>
	<!-- 左边的二级menu -->
	<tag>
		<name>newversionLeftMenu</name>
		<tag-class>com.sopia.newversion.tags.NewVersionLeftMenu</tag-class>
	</tag>
	<!--  中间的三级menu -->
	<tag>
		<name>newversionCenterMenu</name>
		<tag-class>com.sopia.newversion.tags.NewVersionCenterMenu</tag-class>
	</tag>
	
	<tag>
		<name>newversionCenterMenuDiv</name>
		<tag-class>com.sopia.newversion.tags.NewVersionCenterMenuDiv</tag-class>
	</tag>
	
	<tag>
		<name>newversionCenterMenuDiv1</name>
		<tag-class>com.sopia.newversion.tags.NewVersionCenterMenuDiv1</tag-class>
	</tag>
	
</taglib>
