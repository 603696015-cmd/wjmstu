
function checkNumber(number) {
	var reust = /^\d*$/;
	if (reust.exec(number)) {
		return true;
	}
	return false;
}
function checkFloat(number) {
	var reust = /^\d+$|^\d+\.?\d+$/;
	if (reust.exec(number)) {
		return true;
	}
	return false;
}
function checkDateTime(a,title) {
	//var arr = a.split(" ");
	//var gz1 = /^((((1[6-9]|[2-9]\d)\d{2})-(0?[13578]|1[02])-(0?[1-9]|[12]\d|3[01]))|(((1[6-9]|[2-9]\d)\d{2})-(0?[13456789]|1[012])-(0?[1-9]|[12]\d|30))|(((1[6-9]|[2-9]\d)\d{2})-0?2-(0?[1-9]|1\d|2[0-8]))|(((1[6-9]|[2-9]\d)(0[48]|[2468][048]|[13579][26])|((16|[2468][048]|[3579][26])00))-0?2-29-))$/;
	//var gz2 = /^(0\d{1}|1\d{1}|2[0-3]):[0-5]\d{1}:([0-5]\d{1})$/;
	//var gz3 = /^(\d{1,4})(-|\/)(\d{1,2})\2(\d{1,2})$/;
	//var gz4 = /^(\d{1,2}):(\d{1,2}):(\d{1,2})$/;
	//return gz1.test(arr[0]) && gz2.test(arr[1]) && gz3.test(arr[0]) && gz4.test(arr[1]);
	var test = /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/
	if(!test.test(a)){
		alert(title+"的格式错误,必须为yyyy-MM-dd HH:mm:ss");
		return false;
	}
	var y = parseInt(a.substring(0,4),10);
	var m = parseInt(a.substring(5,7),10);
	var d = parseInt(a.substring(8,10),10);
	var hh = parseInt(a.substring(11,13),10);
	var mm = parseInt(a.substring(14,16),10);
	var ss = parseInt(a.substring(17,19),10);
	if(y<1900||y>2200){
		alert(title+"的年份必须在1900到2200之间!");
		return false;
	}
	if(m<1||m>12){
		alert(title+"的月份必须在1到12之间!");
		return false;
	}
	var maxd = 0;
	switch(m){
		case 1 : 
		case 3 : 
		case 5 : 
		case 7 : 
		case 8 : 
		case 10 : 
		case 12 :
			maxd = 31;
			break;
		case 2 :
			if(y%4==0)
			maxd = 29;
			else
			maxd = 28;
			break;
		case 4 :
		case 6 : 
		case 9 : 
		case 11:
			maxd = 30;
			break;
	}
	if(d<1||d>maxd){
		alert(title+"的"+y+"年的"+m+"月必须在1到"+maxd+"之间!");
		return false;
	}
	if(hh<0||hh>23){
		alert(title+"的小时必须在0到23之间!");
		return false;
	}
	if(mm<0||mm>59){
		alert(title+"的分钟必须在0到59之间!");
		return false;
	}
	if(ss<0||ss>59){
		alert(title+"的秒钟必须在0到59之间!");
		return false;
	}
	return true;
}
function toDate(str) {
	var sd = str.split("-");
	//alert(sd);
	return new Date(sd[0], sd[1] - 1, sd[2], sd[3], sd[4], sd[5]);
}
function dateTimeCheck(classStarttime, classFinishtime, eroomStarttime, eroomFinishtime) {
	//alert(classStarttime+"**"+classFinishtime+"**"+eroomStarttime+"**"+eroomFinishtime);
	if (eroomStarttime.indexOf(" ") == -1) {
		eroomStarttime = eroomStarttime + "-00-00-00";
	}
	while (eroomStarttime.indexOf(" ") != -1) {
		eroomStarttime = eroomStarttime.replace(" ", "-");
	}
	while (eroomStarttime.indexOf(":") != -1) {
		eroomStarttime = eroomStarttime.replace(":", "-");
	}
	if (eroomFinishtime.indexOf(" ") == -1) {
		eroomFinishtime = eroomFinishtime + "-00-00-00";
	}
	while (eroomFinishtime.indexOf(" ") != -1) {
		eroomFinishtime = eroomFinishtime.replace(" ", "-");
	}
	while (eroomFinishtime.indexOf(":") != -1) {
		eroomFinishtime = eroomFinishtime.replace(":", "-");
	}
	if (toDate(eroomStarttime).getTime() < toDate(classStarttime).getTime()) {
		alert("\xe8\x80\x83\xe5\x9c\xba\xe5\xbc\x80\xe5\xa7\x8b\xe6\x97\xb6\xe9\x97\xb4\xe4\xb8\x8d\xe8\x83\xbd\xe5\xb0\x8f\xe4\xba\x8e\xe5\x9f\xb9\xe8\xae\xe7\x8f\xe5\xbc\x80\xe5\xa7\x8b\xe6\x97\xb6\xe9\x97\xb4\xef\xbc\x81");
		return false;
	}
	if (toDate(eroomFinishtime).getTime() > toDate(classFinishtime).getTime()) {
		alert("\xe8\x80\x83\xe5\x9c\xba\xe7\xbb\x93\xe6\x9d\x9f\xe6\x97\xb6\xe9\x97\xb4\xe4\xb8\x8d\xe8\x83\xbd\xe5\xa4\xa7\xe4\xba\x8e\xe5\x9f\xb9\xe8\xae\xe7\x8f\xe7\xbb\x93\xe6\x9d\x9f\xe6\x97\xb6\xe9\x97\xb4\xef\xbc\x81");
		return false;
	}
	//alert("1:"+toDate(eroomFinishtime));
	//alert("2:"+toDate(classFinishtime).getTime());
	return true;
}

